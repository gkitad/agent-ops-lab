# Public entry point. PUBLIC_HOST is filled in at deploy time from the droplet's
# public IP via sslip.io (e.g. 138-197-164-83.sslip.io), so HTTPS works with a
# real Let's Encrypt certificate and no domain purchase.
#   /api/lab, /api/incidents*   incident service (agent)
#   /api/*, /status             labctl (status, self-tests)
#   everything else             the web app (static export of web/)
(routes) {
	encode gzip
	@agent path /api/lab /api/incidents /api/incidents/*
	handle @agent {
		reverse_proxy 127.0.0.1:8090 {
			flush_interval -1
		}
	}
	@labctl path /api/* /status
	handle @labctl {
		reverse_proxy 127.0.0.1:8080
	}
	handle {
		root * /srv/web
		try_files {path} {path}.html /index.html
		file_server
	}
}

PUBLIC_HOST {
	import routes
}

http://PUBLIC_IP {
	import routes
}
