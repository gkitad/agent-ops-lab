[Unit]
Description=Agent Ops Lab incident service (127.0.0.1:8090)
After=opsmcp.service docker.service
Requires=docker.service

[Service]
Environment=LAB_ROOT=/opt/agent-ops-lab
WorkingDirectory=/opt/agent-ops-lab/opsagent
ExecStart=/opt/agent-ops-lab/.venv/bin/python /opt/agent-ops-lab/opsagent/service.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
